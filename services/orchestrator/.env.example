# Postgres connection string (async driver). Overridden by Kubernetes in production.
DATABASE_URL=postgresql+asyncpg://diffreview:diffreview@localhost:5432/diffreview

# GitHub App identity: numeric App ID and the private key from the .pem file.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# OpenAI, used by the review agents.
OPENAI_API_KEY=

# LangFuse tracing (optional locally).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
